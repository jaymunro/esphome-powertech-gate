[
  {
    "helper_type": "template",
    "name": "Car gate",
    "config": {
      "next_step_id": "cover",
      "state": "{{ states('sensor.powertech_gate_bluetooth_car_state_source') }}",
      "device_class": "gate",
      "open_cover": [
        {
          "condition": "state",
          "entity_id": "lock.gate_lock",
          "state": "unlocked"
        },
        {
          "condition": "or",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_car_state_source",
              "state": "open"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_car_state_source",
              "state": "closed"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_car_state_source",
              "state": "opening"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_car_state_source",
              "state": "closing"
            }
          ]
        },
        {
          "action": "button.press",
          "target": {
            "entity_id": "button.powertech_gate_bluetooth_car_open"
          }
        }
      ],
      "close_cover": [
        {
          "action": "button.press",
          "target": {
            "entity_id": "button.powertech_gate_bluetooth_car_close"
          }
        }
      ],
      "stop_cover": [
        {
          "action": "button.press",
          "target": {
            "entity_id": "button.powertech_gate_bluetooth_stop"
          }
        }
      ],
      "additional_options": {
        "availability": "{{ is_state('binary_sensor.powertech_gate_status', 'on') and states('sensor.powertech_gate_bluetooth_car_state_source') in ['open','closed','opening','closing'] }}"
      }
    }
  },
  {
    "helper_type": "template",
    "name": "Pedestrian gate",
