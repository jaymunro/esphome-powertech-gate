  {
    "helper_type": "template",
    "name": "Gate state",
    "config": {
      "next_step_id": "binary_sensor",
      "state": "{{ is_state('sensor.powertech_gate_bluetooth_gate_state_source', 'open') }}",
      "device_class": "opening",
      "additional_options": {
        "availability": "{{ is_state('binary_sensor.powertech_gate_status', 'on') and states('sensor.powertech_gate_bluetooth_gate_state_source') in ['open','closed'] }}"
      }
    }
  }
]
