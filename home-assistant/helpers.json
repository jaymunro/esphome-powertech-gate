            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_pedestrian_state_source",
              "state": "open"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_pedestrian_state_source",
              "state": "closed"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_pedestrian_state_source",
              "state": "opening"
            },
            {
              "condition": "state",
              "entity_id": "sensor.powertech_gate_bluetooth_pedestrian_state_source",
              "state": "closing"
            }
          ]
        },
        {
          "action": "button.press",
